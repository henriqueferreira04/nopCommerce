{
  "annotations": { "list": [] },
  "description": "Operations dashboard for the nopCommerce Search → View Product flow. Monitors search index health, pricing cache performance, error rates, and distributed traces.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Search Pipeline Health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 101,
      "type": "row"
    },
    {
      "title": "Search Throughput",
      "description": "Rate of non-empty search queries hitting CatalogController.Search() and SearchProducts(). Establishes the baseline. A drop means broken search page, deployment issue, or upstream traffic loss.",
      "type": "timeseries",
      "id": 4,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "custom": { "fillOpacity": 20, "lineWidth": 2, "spanNulls": false },
          "unit": "opm"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(search_performed_total[5m]) * 60",
          "legendFormat": "Searches/min",
          "refId": "A"
        }
      ]
    },
    {
      "title": "No-Results Ratio",
      "description": "KEY OPERATIONAL SIGNAL. Ratio of searches returning zero products. Baseline ~10-15%. A spike to 50%+ means catalog data is missing, search index is corrupted, or DB connection is degraded — even though the app still returns HTTP 200. Detects silent failures.",
      "type": "gauge",
      "id": 5,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(search_no_results_total / search_performed_total) * 100",
          "legendFormat": "No-results %",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Search vs No-Results Over Time",
      "description": "Overlay of total search rate and no-results rate. Use this to correlate when degradation started — if both lines rise together, it's a traffic spike hitting missing catalog data. If no-results rises while searches stay flat, something broke in the backend.",
      "type": "timeseries",
      "id": 6,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15, "lineWidth": 2, "spanNulls": false },
          "unit": "opm"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "No results/min" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Searches/min" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "rate(search_performed_total[5m]) * 60",
          "legendFormat": "Searches/min",
          "refId": "A"
        },
        {
          "expr": "rate(search_no_results_total[5m]) * 60",
          "legendFormat": "No results/min",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Pricing Cache Health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 102,
      "type": "row"
    },
    {
      "title": "Pricing Cache Hit Rate",
      "description": "LEADING INDICATOR. Ratio of cache hits to total pricing lookups in GetFinalPrice. Healthy cache shows 90%+. A drop means: cache was flushed (deployment), TTL misconfigured, memory pressure evicting entries, or new products flooding in (catalog import). Expect latency to increase shortly after a sustained drop. Starts at 0% on cold start and climbs as the cache warms.",
      "type": "gauge",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(pricing_cache_hit_total[1m]) / (rate(pricing_cache_hit_total[1m]) + rate(pricing_cache_miss_total[1m])) * 100",
          "legendFormat": "Cache hit %",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Cache Hit Rate vs Search Volume",
      "description": "Overlay of cache hit rate and search throughput. A stable high hit rate during rising search volume means the cache is healthy. If hit rate drops while search volume is flat, the cache is degraded (flush, eviction, TTL issue). On cold start, expect the hit rate to climb from 0% as the cache warms.",
      "type": "timeseries",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Cache hit %" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "percent" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Searches/min" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } },
              { "id": "unit", "value": "opm" }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "rate(pricing_cache_hit_total[1m]) / (rate(pricing_cache_hit_total[1m]) + rate(pricing_cache_miss_total[1m])) * 100",
          "legendFormat": "Cache hit %",
          "refId": "A"
        },
        {
          "expr": "rate(search_performed_total[5m]) * 60",
          "legendFormat": "Searches/min",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Flow Error Rate",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 103,
      "type": "row"
    },
    {
      "title": "5xx — Search & Product Flow",
      "description": "Error rate on the Search → View Product flow endpoints (/search, /catalog/searchtermautocomplete, product detail pages). A spike isolated here while site-wide errors stay flat means the flow is broken, not the whole app.",
      "type": "timeseries",
      "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 25, "lineWidth": 2, "spanNulls": false },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Flow 5xx/s" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Site-wide 5xx/s" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\", http_route=~\"/search/|catalog/searchtermautocomplete|\\{SeName\\}\"}[1m]))",
          "legendFormat": "Flow 5xx/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[1m]))",
          "legendFormat": "Site-wide 5xx/s",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Flow Error %",
      "description": "Percentage of Search → View Product requests returning 5xx. Green <1%, yellow 1-5%, red >5%.",
      "type": "gauge",
      "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\", http_route=~\"/search/|catalog/searchtermautocomplete|\\{SeName\\}\"}[1m])) / sum(rate(http_server_request_duration_seconds_count{http_route=~\"/search/|catalog/searchtermautocomplete|\\{SeName\\}\"}[1m])) * 100",
          "legendFormat": "Flow error %",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Distributed Traces",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 104,
      "type": "row"
    },
    {
      "title": "Recent Traces — Search",
      "description": "Traces for text search (search box submit, AJAX pagination, autocomplete).",
      "type": "table",
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "targets": [
        {
          "queryType": "search",
          "service": "nopCommerce",
          "operation": "Catalog.Search",
          "limit": 10,
          "refId": "A"
        },
        {
          "queryType": "search",
          "service": "nopCommerce",
          "operation": "Catalog.SearchProducts",
          "limit": 10,
          "refId": "B"
        },
        {
          "queryType": "search",
          "service": "nopCommerce",
          "operation": "Catalog.SearchTermAutoComplete",
          "limit": 10,
          "refId": "C"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "title": "Recent Traces — Category & Manufacturer",
      "description": "Traces for browsing by category and manufacturer.",
      "type": "table",
      "id": 20,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "targets": [
        {
          "queryType": "search",
          "service": "nopCommerce",
          "operation": "Catalog.Category",
          "limit": 10,
          "refId": "A"
        },
        {
          "queryType": "search",
          "service": "nopCommerce",
          "operation": "Catalog.Manufacturer",
          "limit": 10,
          "refId": "B"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "title": "Recent Traces — Product Details",
      "description": "Traces for viewing a product page.",
      "type": "table",
      "id": 21,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "targets": [
        {
          "queryType": "search",
          "service": "nopCommerce",
          "operation": "Product.ProductDetails",
          "limit": 10,
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "title": "Recent Traces — Tags, New Products, Vendors & Filters",
      "description": "Traces for product tags, new products page, vendor browsing, and filter level search.",
      "type": "table",
      "id": 22,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "targets": [
        {
          "queryType": "search",
          "service": "nopCommerce",
          "operation": "Catalog.ProductsByTag",
          "limit": 5,
          "refId": "A"
        },
        {
          "queryType": "search",
          "service": "nopCommerce",
          "operation": "Catalog.NewProducts",
          "limit": 5,
          "refId": "B"
        },
        {
          "queryType": "search",
          "service": "nopCommerce",
          "operation": "Catalog.Vendor",
          "limit": 5,
          "refId": "C"
        },
        {
          "queryType": "search",
          "service": "nopCommerce",
          "operation": "Catalog.SearchByFilterLevelValues",
          "limit": 5,
          "refId": "D"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "title": "Runtime Health",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
      "id": 105,
      "type": "row",
      "panels": [
        {
          "title": "GC Heap Size",
          "description": "Memory used by the .NET GC. A steadily growing heap without plateaus indicates a memory leak. Correlate with deployment times.",
          "type": "timeseries",
          "id": 12,
          "gridPos": { "h": 8, "w": 8, "x": 0, "y": 45 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "custom": { "fillOpacity": 15, "lineWidth": 2, "spanNulls": false },
              "unit": "bytes"
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "process_runtime_dotnet_gc_heap_size_bytes",
              "legendFormat": "Heap size",
              "refId": "A"
            }
          ]
        },
        {
          "title": "GC Collections",
          "description": "GC collection rate by generation. Frequent Gen2 collections = memory pressure, possible large object allocation issues.",
          "type": "timeseries",
          "id": 13,
          "gridPos": { "h": 8, "w": 8, "x": 8, "y": 45 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": false },
              "unit": "short"
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "rate(process_runtime_dotnet_gc_collections_count_total[5m])",
              "legendFormat": "Gen {{generation}}",
              "refId": "A"
            }
          ]
        },
        {
          "title": "Thread Pool",
          "description": "Active threads and work item queue. Growing queue with stable thread count = pool saturation, requests are waiting. May correlate with latency spikes.",
          "type": "timeseries",
          "id": 14,
          "gridPos": { "h": 8, "w": 8, "x": 16, "y": 45 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": false },
              "unit": "short"
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "process_runtime_dotnet_thread_pool_threads_count",
              "legendFormat": "Active threads",
              "refId": "A"
            },
            {
              "expr": "rate(process_runtime_dotnet_thread_pool_queue_length[5m])",
              "legendFormat": "Queue length rate",
              "refId": "B"
            }
          ]
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["nopcommerce", "operations"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "nopCommerce — Operations",
  "uid": "nopcommerce-overview",
  "version": 3
}
